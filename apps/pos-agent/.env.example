# URL da API do RestoGest (termina em /api)
RESTGEST_API_URL=https://app.exemplo.ao/api
# Definições → Mesas → "Gerar chave do agente" (uma chave por unidade)
RESTGEST_AGENT_KEY=
# Caminho do ficheiro SQLite do POS (aberto só em leitura)
POS_DB_PATH=C:\caminho\para\database.db
# Consulta que devolve as mesas abertas agora (coluna "mesa" ou a primeira coluna); validar com `npm run check`.
# Exemplo para POS com documentos em docheader e mesas como acumuladores (BD analisada em 2026-11):
# Factura-recibo (1018) em estado Aberto (8001), ainda sem número, do dia de negócio actual ou anterior.
POS_OPEN_TABLES_QUERY=SELECT accumulator AS mesa FROM docheader WHERE docconfig_id = 1018 AND docstatus_id = 8001 AND deleted = 0 AND doc_number = 0 AND accumulator > 0 AND doc_date >= CAST(julianday('now', 'localtime') - julianday('1901-01-01') AS INTEGER) - 1
POS_SYNC_SECONDS=15

# ---- Vendas em tempo real (facturas fechadas → receita, stock e fecho de caixa)
# POS_SALES=off para desligar
POS_NAME=Winrest
# Primeira execução: a partir de que dia enviar (por defeito o dia de negócio anterior)
# POS_SALES_FROM=2026-11-01
# Códigos do Winrest (BD de demonstração); só mudar se `npm run check` mostrar outros
# POS_SALE_DOCTYPES=1018,1005
# POS_INTERNAL_DOCTYPES=1300
# POS_INTERNAL_PAYMETHODS=CI
# POS_CLOSED_STATUS=8002
# POS_CANCELLED_STATUS=8003
