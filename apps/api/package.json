{
  "name": "@restgest/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file=../../.env dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.6",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/client": "~6.19.3",
    "@restgest/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "dotenv-cli": "^8.0.0",
    "pino-pretty": "^13.2.0",
    "prisma": "~6.19.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "tsup": {
    "entry": [
      "src/server.ts"
    ],
    "format": [
      "esm"
    ],
    "target": "node20",
    "noExternal": [
      "@restgest/shared"
    ]
  }
}
