generator client {
  provider = "prisma-client-js"
}

// Convenção: tabelas de negócio têm
//   tenantId String @default(dbgenerated("current_setting('app.tenant_id')"))
// O valor é sempre injectado por tenantDb(); o default só existe para o tipo ficar
// opcional nos inputs e para falhar (NOT NULL / setting inexistente) se alguém escrever sem tenant.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Core ----------

enum Plan {
  STOCK
  COMPLETO
}

enum NegativeStockPolicy {
  /// permite stock negativo (gera alerta)
  ALLOW
  BLOCK
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// Sem tenantId: é a própria raiz do tenant.
model Tenant {
  id                  String              @id @default(cuid())
  name                String
  nif                 String?
  plan                Plan                @default(STOCK)
  featureOverrides    Json                @default("{}")
  status              TenantStatus        @default(ACTIVE)
  /// Limites contratados (null = sem limite)
  maxUnits            Int?
  maxUsers            Int?
  smsMonthlyLimit     Int?
  aiMonthlyLimit      Int?
  negativeStockPolicy NegativeStockPolicy @default(ALLOW)
  /// horário de silêncio dos SMS ("HH:MM", fuso de apresentação); vazio = sem silêncio
  smsQuietStart       String?
  smsQuietEnd         String?
  /// true = um SMS-resumo diário em vez de um SMS por alerta
  smsDigest           Boolean             @default(false)
  /// parâmetros de salários (sem valores por defeito no código)
  payrollWeeklyHours  Int?
  payrollOvertimeRate Decimal?            @db.Decimal(5, 2)
  payrollMonthDays    Int?
  /// diferença de caixa (AOA) acima da qual a justificação é obrigatória e há alerta
  cashDifferenceLimit Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  units                  Unit[]
  locations              StockLocation[]
  users                  User[]
  roles                  Role[]
  userUnits              UserUnit[]
  auditLogs              AuditLog[]
  refreshTokens          RefreshToken[]
  passwordResets         PasswordReset[]
  categories             Category[]
  measureUnits           MeasureUnit[]
  products               Product[]
  productUnitConversions ProductUnitConversion[]
  productLocationLimits  ProductLocationLimit[]
  suppliers              Supplier[]
  supplierProducts       SupplierProduct[]
  lots                   Lot[]
  stockMovements         StockMovement[]
  stockBalances          StockBalance[]
  stockLotBalances       StockLotBalance[]
  stockCosts             StockCost[]
  sequences              DocumentSequence[]
  purchaseOrders         PurchaseOrder[]
  poLines                PurchaseOrderLine[]
  receipts               GoodsReceipt[]
  receiptLines           GoodsReceiptLine[]
  transfers              Transfer[]
  transferLines          TransferLine[]
  inventoryCounts        InventoryCount[]
  inventoryLines         InventoryCountLine[]
  saleItems              SaleItem[]
  recipeLines            RecipeLine[]
  outputLocations        CategoryOutputLocation[]
  importProfiles         ImportProfile[]
  posMappings            PosItemMapping[]
  salesImports           SalesImport[]
  salesImportLines       SalesImportLine[]
  alertRules             AlertRule[]
  alerts                 Alert[]
  notifications          Notification[]
  smsLogs                SmsLog[]
  aiRequests             AiRequest[]
  aiReports              AiReport[]
  wasteReasons           WasteReason[]
  departments            Department[]
  positions              Position[]
  employees              Employee[]
  allowances             EmployeeAllowance[]
  employeeDocs           EmployeeDocument[]
  shifts                 Shift[]
  attendance             Attendance[]
  leaves                 Leave[]
  deductions             EmployeeDeduction[]
  payrollRuns            PayrollRun[]
  payrollLines           PayrollLine[]
  costCategories         CostCategory[]
  paymentMethods         PaymentMethod[]
  dailyCosts             DailyCost[]
  recurringCosts         RecurringCost[]
  cashSessions           CashSession[]
  cashAmounts            CashSessionAmount[]
  cashMovements          CashMovement[]
  payables               Payable[]
  payablePayments        PayablePayment[]
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  name      String
  address   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  locations       StockLocation[]
  userUnits       UserUnit[]
  costs           StockCost[]
  orders          PurchaseOrder[]
  outputLocations CategoryOutputLocation[]
  salesImports    SalesImport[]
  employees       Employee[]
  payrollRuns     PayrollRun[]
  dailyCosts      DailyCost[]
  recurringCosts  RecurringCost[]
  cashSessions    CashSession[]
  payables        Payable[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

enum LocationType {
  WAREHOUSE
  BAR
  KITCHEN
  COLD_ROOM
  OTHER
}

model StockLocation {
  id        String       @id @default(cuid())
  tenantId  String       @default(dbgenerated("current_setting('app.tenant_id')"))
  unitId    String
  name      String
  type      LocationType @default(OTHER)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  limits           ProductLocationLimit[]
  tenant           Tenant                   @relation(fields: [tenantId], references: [id])
  unit             Unit                     @relation(fields: [tenantId, unitId], references: [tenantId, id])
  stockMovements   StockMovement[]
  stockBalances    StockBalance[]
  stockLotBalances StockLotBalance[]
  receipts         GoodsReceipt[]
  transfersOut     Transfer[]               @relation("TransferFrom")
  transfersIn      Transfer[]               @relation("TransferTo")
  inventoryCounts  InventoryCount[]
  outputFor        CategoryOutputLocation[]

  @@unique([tenantId, unitId, name])
  @@unique([tenantId, id])
}

// ---------- Super Admin (COMUNICA) — fora de qualquer tenant ----------

model SuperAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Catálogo ----------
// Relações internas ao tenant usam FK composta (tenantId, id): a BD impede referências a outro tenant.

model Category {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  parentId  String?
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant                   @relation(fields: [tenantId], references: [id])
  parent          Category?                @relation("CategoryTree", fields: [tenantId, parentId], references: [tenantId, id], onDelete: Restrict)
  children        Category[]               @relation("CategoryTree")
  products        Product[]
  inventoryCounts InventoryCount[]
  outputLocations CategoryOutputLocation[]

  @@unique([tenantId, parentId, name])
  @@unique([tenantId, id])
}

model MeasureUnit {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  name      String
  symbol    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant              Tenant                  @relation(fields: [tenantId], references: [id])
  stockProducts       Product[]               @relation("StockUnit")
  purchaseProducts    Product[]               @relation("PurchaseUnit")
  consumptionProducts Product[]               @relation("ConsumptionUnit")
  conversions         ProductUnitConversion[]
  poLines             PurchaseOrderLine[]
  receiptLines        GoodsReceiptLine[]
  recipeLines         RecipeLine[]

  @@unique([tenantId, symbol])
  @@unique([tenantId, id])
}

model Product {
  id                  String   @id @default(cuid())
  tenantId            String   @default(dbgenerated("current_setting('app.tenant_id')"))
  code                String
  name                String
  categoryId          String
  /// unidade em que o stock é contado (ex.: garrafa)
  stockUnitId         String
  /// unidade habitual de compra (ex.: caixa) — precisa de conversão
  purchaseUnitId      String?
  /// unidade usada nas fichas técnicas (ex.: ml) — precisa de conversão
  consumptionUnitId   String?
  tracksLots          Boolean  @default(false)
  reorderPoint        Decimal? @db.Decimal(14, 3)
  preferredSupplierId String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id])
  category          Category     @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  stockUnit         MeasureUnit  @relation("StockUnit", fields: [tenantId, stockUnitId], references: [tenantId, id])
  purchaseUnit      MeasureUnit? @relation("PurchaseUnit", fields: [tenantId, purchaseUnitId], references: [tenantId, id], onDelete: Restrict)
  consumptionUnit   MeasureUnit? @relation("ConsumptionUnit", fields: [tenantId, consumptionUnitId], references: [tenantId, id], onDelete: Restrict)
  preferredSupplier Supplier?    @relation("PreferredSupplier", fields: [tenantId, preferredSupplierId], references: [tenantId, id], onDelete: Restrict)

  conversions      ProductUnitConversion[]
  locationLimits   ProductLocationLimit[]
  supplierProducts SupplierProduct[]
  lots             Lot[]
  movements        StockMovement[]
  balances         StockBalance[]
  lotBalances      StockLotBalance[]
  costs            StockCost[]
  poLines          PurchaseOrderLine[]
  receiptLines     GoodsReceiptLine[]
  transferLines    TransferLine[]
  inventoryLines   InventoryCountLine[]
  recipeLines      RecipeLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId, categoryId])
}

/// 1 [unit] = factor × unidade de stock (ex.: caixa = 24 garrafas; ml = 1/750 garrafa)
model ProductUnitConversion {
  id        String  @id @default(cuid())
  tenantId  String  @default(dbgenerated("current_setting('app.tenant_id')"))
  productId String
  unitId    String
  factor    Decimal @db.Decimal(20, 10)

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  product Product     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  unit    MeasureUnit @relation(fields: [tenantId, unitId], references: [tenantId, id])

  @@unique([tenantId, productId, unitId])
}

model ProductLocationLimit {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id')"))
  productId  String
  locationId String
  minQty     Decimal? @db.Decimal(14, 3)
  maxQty     Decimal? @db.Decimal(14, 3)

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id])

  @@id([productId, locationId])
  @@index([tenantId])
}

model Supplier {
  id              String   @id @default(cuid())
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id')"))
  name            String
  nif             String?
  contactName     String?
  phone           String?
  email           String?
  address         String?
  /// prazo de pagamento em dias (vencimento das contas a pagar)
  paymentTermDays Int      @default(0)
  notes           String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  products          SupplierProduct[]
  preferredProducts Product[]         @relation("PreferredSupplier")
  orders            PurchaseOrder[]
  receipts          GoodsReceipt[]
  payables          Payable[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model SupplierProduct {
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id')"))
  supplierId   String
  productId    String
  supplierCode String?
  /// último preço em AOA (inteiro), por unidade de compra
  lastPrice    Int?
  lastPriceAt  DateTime?

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  supplier Supplier @relation(fields: [tenantId, supplierId], references: [tenantId, id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@id([supplierId, productId])
  @@index([tenantId, productId])
}

// ---------- Stock ----------

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  CONSUMPTION
  WASTE
  TRANSFER_OUT
  TRANSFER_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  INVENTORY_ADJUST
  RETURN_SUPPLIER
}

model Lot {
  id         String    @id @default(cuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id')"))
  productId  String
  code       String
  expiryDate DateTime? @db.Date
  createdAt  DateTime  @default(now())

  tenant    Tenant            @relation(fields: [tenantId], references: [id])
  product   Product           @relation(fields: [tenantId, productId], references: [tenantId, id])
  movements StockMovement[]
  balances  StockLotBalance[]

  @@unique([tenantId, productId, code])
  @@unique([tenantId, id])
}

/// Livro de movimentos IMUTÁVEL. Quantidade com sinal na unidade de stock (+ entra, − sai).
/// Correcções = novo movimento com reversalOfId (estorno), nunca UPDATE/DELETE.
model StockMovement {
  id           String       @id @default(cuid())
  tenantId     String       @default(dbgenerated("current_setting('app.tenant_id')"))
  productId    String
  locationId   String
  lotId        String?
  type         MovementType
  qty          Decimal      @db.Decimal(14, 3)
  /// custo por unidade de stock (taxa, com casas decimais)
  unitCost     Decimal      @db.Decimal(18, 4)
  /// qty × unitCost em AOA (inteiro, com sinal)
  totalCost    Int
  /// saldo do local após este movimento (ordem de registo)
  balanceAfter Decimal      @db.Decimal(14, 3)
  reason       String?
  /// documento de origem (ex.: GoodsReceipt, Transfer, SalesImport, InventoryCount)
  refType      String?
  refId        String?
  reversalOfId String?
  userId       String?
  occurredAt   DateTime
  createdAt    DateTime     @default(now())

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  product    Product        @relation(fields: [tenantId, productId], references: [tenantId, id])
  location   StockLocation  @relation(fields: [tenantId, locationId], references: [tenantId, id])
  lot        Lot?           @relation(fields: [tenantId, lotId], references: [tenantId, id], onDelete: Restrict)
  user       User?          @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  reversalOf StockMovement? @relation("Reversal", fields: [tenantId, reversalOfId], references: [tenantId, id], onDelete: Restrict)
  reversedBy StockMovement? @relation("Reversal")

  @@unique([tenantId, id])
  @@unique([tenantId, reversalOfId])
  @@index([tenantId, productId, locationId, occurredAt])
  @@index([tenantId, productId, locationId, createdAt])
  @@index([tenantId, refType, refId])
  /// relatórios por período (consumo, quebras, resultados, anomalias)
  @@index([tenantId, occurredAt])
}

/// Saldo por local (derivado do livro, mantido na mesma transacção).
model StockBalance {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id')"))
  productId  String
  locationId String
  qty        Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id])
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id])

  @@id([productId, locationId])
  @@index([tenantId, locationId])
}

model StockLotBalance {
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id')"))
  productId  String
  locationId String
  lotId      String
  qty        Decimal  @default(0) @db.Decimal(14, 3)
  updatedAt  DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  product  Product       @relation(fields: [tenantId, productId], references: [tenantId, id])
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id])
  lot      Lot           @relation(fields: [tenantId, lotId], references: [tenantId, id])

  @@id([lotId, locationId])
  @@index([tenantId, productId, locationId])
}

/// Custo médio ponderado por produto e unidade (estabelecimento). A linha é o lock dos movimentos.
model StockCost {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  productId String
  unitId    String
  /// quantidade total na unidade (soma dos locais)
  qty       Decimal  @default(0) @db.Decimal(14, 3)
  avgCost   Decimal  @default(0) @db.Decimal(18, 4)
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id])
  unit    Unit    @relation(fields: [tenantId, unitId], references: [tenantId, id])

  @@id([productId, unitId])
  @@index([tenantId])
}

// ---------- Documentos ----------

/// Numeração sequencial por tenant e tipo de documento (PO, GR, TR, INV).
model DocumentSequence {
  tenantId String @default(dbgenerated("current_setting('app.tenant_id')"))
  key      String
  value    Int    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, key])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  tenantId     String              @default(dbgenerated("current_setting('app.tenant_id')"))
  number       Int
  supplierId   String
  unitId       String
  status       PurchaseOrderStatus @default(DRAFT)
  expectedDate DateTime?           @db.Date
  notes        String?
  createdById  String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  supplier Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  unit     Unit                @relation(fields: [tenantId, unitId], references: [tenantId, id])
  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

model PurchaseOrderLine {
  id          String  @id @default(cuid())
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id')"))
  orderId     String
  productId   String
  /// unidade de medida da encomenda (ex.: caixa)
  unitId      String
  qty         Decimal @db.Decimal(14, 3)
  /// preço por unidade da encomenda, AOA
  unitPrice   Int?
  /// recebido, na mesma unidade da encomenda
  receivedQty Decimal @default(0) @db.Decimal(14, 3)

  tenant       Tenant             @relation(fields: [tenantId], references: [id])
  order        PurchaseOrder      @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product      Product            @relation(fields: [tenantId, productId], references: [tenantId, id])
  unit         MeasureUnit        @relation(fields: [tenantId, unitId], references: [tenantId, id])
  receiptLines GoodsReceiptLine[]

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
}

enum DocumentStatus {
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id             String         @id @default(cuid())
  tenantId       String         @default(dbgenerated("current_setting('app.tenant_id')"))
  number         Int
  supplierId     String
  locationId     String
  orderId        String?
  invoiceNumber  String?
  invoiceDate    DateTime?      @db.Date
  receivedAt     DateTime
  attachmentUrl  String?
  attachmentName String?
  notes          String?
  /// soma das linhas, AOA
  totalAmount    Int
  status         DocumentStatus @default(POSTED)
  createdById    String
  cancelledAt    DateTime?
  cancelledById  String?
  createdAt      DateTime       @default(now())

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  supplier Supplier           @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  location StockLocation      @relation(fields: [tenantId, locationId], references: [tenantId, id])
  order    PurchaseOrder?     @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Restrict)
  lines    GoodsReceiptLine[]
  payable  Payable?

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, supplierId, receivedAt])
}

model GoodsReceiptLine {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id')"))
  receiptId   String
  productId   String
  orderLineId String?
  unitId      String
  qty         Decimal   @db.Decimal(14, 3)
  /// preço por `unitId`, AOA
  unitPrice   Int
  total       Int
  lotCode     String?
  expiryDate  DateTime? @db.Date

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  receipt   GoodsReceipt       @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Cascade)
  product   Product            @relation(fields: [tenantId, productId], references: [tenantId, id])
  unit      MeasureUnit        @relation(fields: [tenantId, unitId], references: [tenantId, id])
  orderLine PurchaseOrderLine? @relation(fields: [tenantId, orderLineId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, receiptId])
}

enum TransferStatus {
  PENDING
  SENT
  RECEIVED
  CANCELLED
}

model Transfer {
  id             String         @id @default(cuid())
  tenantId       String         @default(dbgenerated("current_setting('app.tenant_id')"))
  number         Int
  fromLocationId String
  toLocationId   String
  status         TransferStatus @default(PENDING)
  notes          String?
  createdById    String
  sentAt         DateTime?
  sentById       String?
  receivedAt     DateTime?
  receivedById   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  fromLocation StockLocation  @relation("TransferFrom", fields: [tenantId, fromLocationId], references: [tenantId, id])
  toLocation   StockLocation  @relation("TransferTo", fields: [tenantId, toLocationId], references: [tenantId, id])
  lines        TransferLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, status])
}

/// Quantidades na unidade de stock.
model TransferLine {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id')"))
  transferId  String
  productId   String
  qty         Decimal  @db.Decimal(14, 3)
  sentQty     Decimal? @db.Decimal(14, 3)
  receivedQty Decimal? @db.Decimal(14, 3)
  /// custo unitário médio à saída
  unitCost    Decimal? @db.Decimal(18, 4)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  transfer Transfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)
  product  Product  @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([tenantId, id])
  @@index([tenantId, transferId])
}

enum InventoryStatus {
  OPEN
  CLOSED
  CANCELLED
}

model InventoryCount {
  id              String          @id @default(cuid())
  tenantId        String          @default(dbgenerated("current_setting('app.tenant_id')"))
  number          Int
  locationId      String
  /// contagem parcial por categoria (inclui subcategorias)
  categoryId      String?
  status          InventoryStatus @default(OPEN)
  /// bloqueia movimentos no local enquanto aberta
  blocksMovements Boolean         @default(false)
  notes           String?
  openedById      String
  openedAt        DateTime        @default(now())
  closedById      String?
  closedAt        DateTime?

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  location StockLocation        @relation(fields: [tenantId, locationId], references: [tenantId, id])
  category Category?            @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Restrict)
  lines    InventoryCountLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, locationId, status])
}

model InventoryCountLine {
  id          String    @id @default(cuid())
  tenantId    String    @default(dbgenerated("current_setting('app.tenant_id')"))
  countId     String
  productId   String
  countedQty  Decimal?  @db.Decimal(14, 3)
  countedById String?
  countedAt   DateTime?
  /// preenchidos no fecho
  expectedQty Decimal?  @db.Decimal(14, 3)
  unitCost    Decimal?  @db.Decimal(18, 4)

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  count   InventoryCount @relation(fields: [tenantId, countId], references: [tenantId, id], onDelete: Cascade)
  product Product        @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@unique([countId, productId])
  @@index([tenantId, countId])
}

// ---------- Fichas técnicas ----------

/// Artigo de venda (prato, cocktail, bebida) ou sub-receita (isSubRecipe, não vendido).
model SaleItem {
  id          String   @id @default(cuid())
  tenantId    String   @default(dbgenerated("current_setting('app.tenant_id')"))
  code        String
  name        String
  /// preço de venda, AOA (como no POS)
  salePrice   Int?
  isSubRecipe Boolean  @default(false)
  /// quantidade produzida pela ficha (sub-receitas: ex. 2 L de molho; vendidos: 1)
  yieldQty    Decimal  @default(1) @db.Decimal(14, 3)
  yieldUnit   String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  lines      RecipeLine[]      @relation("RecipeOf")
  usedIn     RecipeLine[]      @relation("SubRecipe")
  mappings   PosItemMapping[]
  importRows SalesImportLine[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
}

/// Ingrediente: produto (qty na unitId, por defeito unidade de consumo) ou sub-receita (qty em unidades do rendimento).
model RecipeLine {
  id          String  @id @default(cuid())
  tenantId    String  @default(dbgenerated("current_setting('app.tenant_id')"))
  saleItemId  String
  productId   String?
  subRecipeId String?
  unitId      String?
  qty         Decimal @db.Decimal(14, 3)
  /// % de perda: bruto = qty / (1 − perda%)
  lossPct     Decimal @default(0) @db.Decimal(5, 2)

  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  saleItem  SaleItem     @relation("RecipeOf", fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Cascade)
  product   Product?     @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)
  subRecipe SaleItem?    @relation("SubRecipe", fields: [tenantId, subRecipeId], references: [tenantId, id], onDelete: Restrict)
  unit      MeasureUnit? @relation(fields: [tenantId, unitId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, saleItemId])
}

/// Local de onde saem os produtos de uma categoria (e subcategorias) numa unidade.
model CategoryOutputLocation {
  tenantId   String @default(dbgenerated("current_setting('app.tenant_id')"))
  categoryId String
  unitId     String
  locationId String

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  category Category      @relation(fields: [tenantId, categoryId], references: [tenantId, id], onDelete: Cascade)
  unit     Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id])
  location StockLocation @relation(fields: [tenantId, locationId], references: [tenantId, id])

  @@id([categoryId, unitId])
  @@index([tenantId])
}

// ---------- Importação de vendas (POS) ----------

enum ImportKind {
  SALES_BY_ITEM
  PAYMENTS
}

model ImportProfile {
  id               String     @id @default(cuid())
  tenantId         String     @default(dbgenerated("current_setting('app.tenant_id')"))
  name             String
  /// sistema de origem (ex.: Winrest); os mapeamentos de artigos são por sistema
  posName          String
  kind             ImportKind @default(SALES_BY_ITEM)
  sheetName        String?
  headerRow        Int        @default(1)
  /// { itemCode, itemName, qty, amount, date } → texto do cabeçalho no ficheiro
  columns          Json
  /// DD/MM/YYYY, YYYY-MM-DD, MM/DD/YYYY (células de data Excel são lidas directamente)
  dateFormat       String     @default("DD/MM/YYYY")
  decimalSeparator String     @default(",")
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  imports SalesImport[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model PosItemMapping {
  id         String   @id @default(cuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id')"))
  posName    String
  posCode    String
  posLabel   String?
  saleItemId String?
  /// artigo sem impacto em stock (ex.: taxa de serviço)
  ignore     Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  saleItem SaleItem? @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, posName, posCode])
}

enum SalesImportStatus {
  PROCESSING
  READY
  FAILED
  CONFIRMED
  CANCELLED
}

model SalesImport {
  id            String            @id @default(cuid())
  tenantId      String            @default(dbgenerated("current_setting('app.tenant_id')"))
  number        Int
  unitId        String
  profileId     String
  fileName      String
  fileUrl       String?
  fileHash      String
  status        SalesImportStatus @default(PROCESSING)
  periodFrom    DateTime?         @db.Date
  periodTo      DateTime?         @db.Date
  rowCount      Int               @default(0)
  totalAmount   Int               @default(0)
  /// erros de parse (linha → mensagem) ou motivo da falha
  errors        Json?
  createdById   String
  createdAt     DateTime          @default(now())
  confirmedAt   DateTime?
  confirmedById String?
  cancelledAt   DateTime?
  cancelledById String?

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  unit    Unit              @relation(fields: [tenantId, unitId], references: [tenantId, id])
  profile ImportProfile     @relation(fields: [tenantId, profileId], references: [tenantId, id])
  lines   SalesImportLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, unitId, periodFrom, periodTo])
  @@index([tenantId, fileHash])
}

model SalesImportLine {
  id         String    @id @default(cuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id')"))
  importId   String
  rowNumber  Int
  posCode    String
  posLabel   String?
  qty        Decimal   @db.Decimal(14, 3)
  amount     Int
  saleDate   DateTime  @db.Date
  /// preenchidos quando a linha é lançada em stock (ou ignorada)
  saleItemId String?
  postedAt   DateTime?

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  import   SalesImport @relation(fields: [tenantId, importId], references: [tenantId, id], onDelete: Cascade)
  saleItem SaleItem?   @relation(fields: [tenantId, saleItemId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, importId, posCode])
}

// ---------- Alertas e notificações ----------

enum AlertType {
  STOCK_BELOW_MIN
  STOCK_OUT
  STOCK_ABOVE_MAX
  EXPIRY_NEAR
  INVENTORY_VARIANCE
  POS_UNMAPPED
  SALES_IMPORT_MISSING
  CASH_DIFFERENCE
  PAYABLE_DUE
  PAYABLE_OVERDUE
  AI_ANOMALY
}

enum AlertStatus {
  OPEN
  RESOLVED
}

/// Configuração por tipo de alerta (linhas em falta usam os valores por defeito de @restgest/shared).
model AlertRule {
  id               String    @id @default(cuid())
  tenantId         String    @default(dbgenerated("current_setting('app.tenant_id')"))
  type             AlertType
  enabled          Boolean   @default(true)
  sms              Boolean   @default(true)
  /// EXPIRY_NEAR: dias; INVENTORY_VARIANCE: %
  threshold        Decimal?  @db.Decimal(10, 2)
  /// perfis que recebem (filtrados pelo acesso à unidade do alerta)
  recipientRoleIds String[]

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, type])
}

model Alert {
  id         String      @id @default(cuid())
  tenantId   String      @default(dbgenerated("current_setting('app.tenant_id')"))
  type       AlertType
  /// deduplicação: um alerta aberto por chave até o estado mudar
  key        String
  unitId     String?
  message    String
  data       Json?
  status     AlertStatus @default(OPEN)
  createdAt  DateTime    @default(now())
  resolvedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  notifications Notification[]
  smsLogs       SmsLog[]

  @@unique([tenantId, id])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, key, status])
}

model Notification {
  id        String    @id @default(cuid())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id')"))
  userId    String
  alertId   String?
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  alert  Alert? @relation(fields: [tenantId, alertId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, userId, readAt, createdAt])
}

enum SmsStatus {
  QUEUED
  SENT
  FAILED
  /// não enviado (sem configuração, limite do plano, sem telefone…)
  SKIPPED
}

model SmsLog {
  id         String    @id @default(cuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id')"))
  alertId    String?
  userId     String?
  to         String
  message    String
  status     SmsStatus @default(QUEUED)
  providerId String?
  /// custo reportado pelo fornecedor, AOA
  cost       Int?
  error      String?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  alert  Alert? @relation(fields: [tenantId, alertId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, status, createdAt])
}

/// Motivos de quebra/desperdício (lista do tenant; o movimento guarda o nome).
model WasteReason {
  id       String  @id @default(cuid())
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id')"))
  name     String
  active   Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
}

// ---------- Recursos humanos ----------

model Department {
  id       String  @id @default(cuid())
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id')"))
  name     String
  active   Boolean @default(true)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  positions Position[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model Position {
  id           String  @id @default(cuid())
  tenantId     String  @default(dbgenerated("current_setting('app.tenant_id')"))
  name         String
  departmentId String?
  active       Boolean @default(true)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  department Department? @relation(fields: [tenantId, departmentId], references: [tenantId, id], onDelete: Restrict)
  employees  Employee[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

enum ContractType {
  PERMANENT
  FIXED_TERM
  OTHER
}

model Employee {
  id                  String       @id @default(cuid())
  tenantId            String       @default(dbgenerated("current_setting('app.tenant_id')"))
  number              String
  name                String
  unitId              String
  positionId          String?
  userId              String?
  contractType        ContractType @default(PERMANENT)
  hireDate            DateTime     @db.Date
  contractEndDate     DateTime?    @db.Date
  terminationDate     DateTime?    @db.Date
  phone               String?
  email               String?
  address             String?
  birthDate           DateTime?    @db.Date
  /// dias de férias por ano (conforme contrato/lei; sem valor por defeito no código)
  vacationDaysPerYear Int?
  // ---- dados sensíveis (hr.sensitive) ----
  /// salário base mensal, AOA
  baseSalary          Int?
  nif                 String?
  idNumber            String?
  socialSecurityNo    String?
  bankName            String?
  /// IBAN encriptado (AES-256-GCM)
  ibanEncrypted       String?
  active              Boolean      @default(true)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  unit         Unit                @relation(fields: [tenantId, unitId], references: [tenantId, id])
  position     Position?           @relation(fields: [tenantId, positionId], references: [tenantId, id], onDelete: Restrict)
  allowances   EmployeeAllowance[]
  documents    EmployeeDocument[]
  shifts       Shift[]
  attendance   Attendance[]
  leaves       Leave[]
  deductions   EmployeeDeduction[]
  payrollLines PayrollLine[]

  @@unique([tenantId, number])
  @@unique([tenantId, id])
  @@index([tenantId, unitId])
}

/// Subsídio fixo mensal (sensível).
model EmployeeAllowance {
  id            String  @id @default(cuid())
  tenantId      String  @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId    String
  name          String
  amount        Int
  /// entra na base do INSS
  inssSubject   Boolean @default(true)
  /// parte isenta de IRT (AOA), conforme a lei para este tipo de subsídio
  irtExemptUpTo Int     @default(0)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

/// Documento do funcionário (sensível).
model EmployeeDocument {
  id         String    @id @default(cuid())
  tenantId   String    @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId String
  name       String
  url        String
  expiresAt  DateTime? @db.Date
  uploadedAt DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

/// Turno escalado (escala semanal).
model Shift {
  id         String   @id @default(cuid())
  tenantId   String   @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId String
  date       DateTime @db.Date
  /// "HH:MM" no fuso de apresentação
  start      String
  end        String

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT_JUSTIFIED
  ABSENT_UNJUSTIFIED
  LEAVE
  DAY_OFF
}

model Attendance {
  id              String           @id @default(cuid())
  tenantId        String           @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId      String
  date            DateTime         @db.Date
  status          AttendanceStatus
  checkIn         String?
  checkOut        String?
  overtimeMinutes Int              @default(0)
  notes           String?
  recordedById    String
  updatedAt       DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
}

enum LeaveType {
  VACATION
  SICK
  MATERNITY
  PATERNITY
  BEREAVEMENT
  MARRIAGE
  OTHER
}

enum LeaveStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id            String      @id @default(cuid())
  tenantId      String      @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId    String
  type          LeaveType
  startDate     DateTime    @db.Date
  endDate       DateTime    @db.Date
  /// dias úteis (seg–sex) no intervalo
  days          Int
  status        LeaveStatus @default(REQUESTED)
  notes         String?
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime    @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId, startDate])
}

// ---------- Salários ----------

/// Tabela fiscal nacional versionada por data de vigência (gerida pelo Super Admin; sem tenantId).
/// Nenhum valor legal fixo no código: os valores são introduzidos e validados com a legislação em vigor.
model TaxTable {
  id               String   @id @default(cuid())
  validFrom        DateTime @unique @db.Date
  /// taxa INSS do trabalhador, % (ex.: 3)
  inssEmployeeRate Decimal  @db.Decimal(5, 2)
  /// taxa INSS da entidade empregadora, % (ex.: 8)
  inssEmployerRate Decimal  @db.Decimal(5, 2)
  /// escalões IRT: [{ upTo: number|null, fixed: number, rate: number (%), excessOver: number }]
  irtBrackets      Json
  notes            String?
  createdAt        DateTime @default(now())

  runs PayrollRun[]
}

enum DeductionType {
  ADVANCE
  OTHER
}

/// Adiantamento ou desconto, abatido em prestações nos processamentos.
model EmployeeDeduction {
  id                String        @id @default(cuid())
  tenantId          String        @default(dbgenerated("current_setting('app.tenant_id')"))
  employeeId        String
  type              DeductionType
  description       String
  date              DateTime      @db.Date
  amount            Int
  installmentAmount Int
  remaining         Int
  createdById       String
  createdAt         DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  employee Employee @relation(fields: [tenantId, employeeId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, employeeId])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
}

model PayrollRun {
  id           String        @id @default(cuid())
  tenantId     String        @default(dbgenerated("current_setting('app.tenant_id')"))
  unitId       String
  year         Int
  month        Int
  status       PayrollStatus @default(DRAFT)
  taxTableId   String
  /// parâmetros usados (horas semanais, multiplicador, dias do mês)
  params       Json
  totalGross   Int           @default(0)
  totalNet     Int           @default(0)
  totalCost    Int           @default(0)
  createdById  String
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id])
  unit     Unit          @relation(fields: [tenantId, unitId], references: [tenantId, id])
  taxTable TaxTable      @relation(fields: [taxTableId], references: [id])
  lines    PayrollLine[]

  @@unique([tenantId, unitId, year, month])
  @@unique([tenantId, id])
}

model PayrollLine {
  id               String @id @default(cuid())
  tenantId         String @default(dbgenerated("current_setting('app.tenant_id')"))
  runId            String
  employeeId       String
  baseSalary       Int
  allowances       Int
  overtime         Int
  absenceDeduction Int
  gross            Int
  inssBase         Int
  inssEmployee     Int
  inssEmployer     Int
  irtBase          Int
  irt              Int
  deductions       Int
  net              Int
  /// detalhe para o recibo (dias, horas extra, subsídios, descontos aplicados)
  details          Json

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  run      PayrollRun @relation(fields: [tenantId, runId], references: [tenantId, id], onDelete: Cascade)
  employee Employee   @relation(fields: [tenantId, employeeId], references: [tenantId, id])

  @@unique([runId, employeeId])
  @@index([tenantId, employeeId])
}

// ---------- Custos diários e fecho de caixa ----------

model CostCategory {
  id       String  @id @default(cuid())
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id')"))
  name     String
  active   Boolean @default(true)

  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  costs     DailyCost[]
  recurring RecurringCost[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

/// Meio de pagamento (numerário, TPA, Multicaixa Express, transferência…), configurável por tenant.
model PaymentMethod {
  id       String  @id @default(cuid())
  tenantId String  @default(dbgenerated("current_setting('app.tenant_id')"))
  name     String
  /// numerário: contado fisicamente, entra no saldo de caixa (sangrias, pagamentos)
  isCash   Boolean @default(false)
  active   Boolean @default(true)

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  costs           DailyCost[]
  amounts         CashSessionAmount[]
  payablePayments PayablePayment[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

model DailyCost {
  id              String   @id @default(cuid())
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id')"))
  unitId          String
  date            DateTime @db.Date
  categoryId      String
  description     String?
  amount          Int
  paymentMethodId String?
  attachmentUrl   String?
  attachmentName  String?
  /// pago pela caixa (movimento EXPENSE)
  cashSessionId   String?
  recurringCostId String?
  createdById     String
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  unit          Unit           @relation(fields: [tenantId, unitId], references: [tenantId, id])
  category      CostCategory   @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  paymentMethod PaymentMethod? @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id], onDelete: Restrict)
  cashSession   CashSession?   @relation(fields: [tenantId, cashSessionId], references: [tenantId, id], onDelete: Restrict)
  recurring     RecurringCost? @relation(fields: [tenantId, recurringCostId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, id])
  @@index([tenantId, unitId, date])
}

/// Custo mensal gerado automaticamente no dia indicado (ex.: renda).
model RecurringCost {
  id                 String   @id @default(cuid())
  tenantId           String   @default(dbgenerated("current_setting('app.tenant_id')"))
  unitId             String
  categoryId         String
  description        String
  amount             Int
  dayOfMonth         Int
  active             Boolean  @default(true)
  /// "YYYY-MM" do último custo gerado (idempotência)
  lastGeneratedMonth String?
  createdAt          DateTime @default(now())

  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  unit     Unit         @relation(fields: [tenantId, unitId], references: [tenantId, id])
  category CostCategory @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  costs    DailyCost[]

  @@unique([tenantId, id])
  @@index([tenantId, active])
}

enum CashSessionStatus {
  OPEN
  CLOSED
  VALIDATED
}

model CashSession {
  id            String            @id @default(cuid())
  tenantId      String            @default(dbgenerated("current_setting('app.tenant_id')"))
  unitId        String
  businessDate  DateTime          @db.Date
  /// turno (vazio = fecho diário único)
  shift         String            @default("")
  openingFloat  Int
  status        CashSessionStatus @default(OPEN)
  /// contagem por notas opcional: { "5000": 3, "1000": 7 }
  denominations Json?
  /// diferença total (contado − esperado), calculada no fecho
  difference    Int?
  justification String?
  notes         String?
  openedById    String
  openedAt      DateTime          @default(now())
  closedById    String?
  closedAt      DateTime?
  validatedById String?
  validatedAt   DateTime?

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  unit      Unit                @relation(fields: [tenantId, unitId], references: [tenantId, id])
  amounts   CashSessionAmount[]
  movements CashMovement[]
  costs     DailyCost[]

  @@unique([tenantId, unitId, businessDate, shift])
  @@unique([tenantId, id])
}

/// Valores por meio de pagamento: sistema (POS ou manual) vs contado.
model CashSessionAmount {
  tenantId        String @default(dbgenerated("current_setting('app.tenant_id')"))
  sessionId       String
  paymentMethodId String
  systemAmount    Int    @default(0)
  countedAmount   Int?

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  session       CashSession   @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id])

  @@id([sessionId, paymentMethodId])
  @@index([tenantId])
}

enum CashMovementType {
  /// sangria (retirada para o cofre/banco)
  WITHDRAWAL
  /// entrada/reforço de caixa
  DEPOSIT
  /// pagamento feito com dinheiro da caixa (gera custo diário)
  EXPENSE
}

model CashMovement {
  id          String           @id @default(cuid())
  tenantId    String           @default(dbgenerated("current_setting('app.tenant_id')"))
  sessionId   String
  type        CashMovementType
  amount      Int
  description String
  /// custo diário gerado por um pagamento (EXPENSE)
  dailyCostId String?          @unique
  createdById String
  createdAt   DateTime         @default(now())

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  session CashSession @relation(fields: [tenantId, sessionId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, sessionId])
}

// ---------- Contas a pagar ----------

enum PayableStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

model Payable {
  id             String        @id @default(cuid())
  tenantId       String        @default(dbgenerated("current_setting('app.tenant_id')"))
  supplierId     String
  unitId         String
  /// recepção de origem (geração automática)
  receiptId      String?
  documentNumber String?
  description    String?
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  amount         Int
  paidAmount     Int           @default(0)
  status         PayableStatus @default(OPEN)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tenant   Tenant           @relation(fields: [tenantId], references: [id])
  supplier Supplier         @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  unit     Unit             @relation(fields: [tenantId, unitId], references: [tenantId, id])
  receipt  GoodsReceipt?    @relation(fields: [tenantId, receiptId], references: [tenantId, id], onDelete: Restrict)
  payments PayablePayment[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptId])
  @@index([tenantId, status, dueDate])
  @@index([tenantId, supplierId])
}

model PayablePayment {
  id              String   @id @default(cuid())
  tenantId        String   @default(dbgenerated("current_setting('app.tenant_id')"))
  payableId       String
  date            DateTime @db.Date
  amount          Int
  paymentMethodId String?
  reference       String?
  attachmentUrl   String?
  attachmentName  String?
  createdById     String
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  payable       Payable        @relation(fields: [tenantId, payableId], references: [tenantId, id], onDelete: Cascade)
  paymentMethod PaymentMethod? @relation(fields: [tenantId, paymentMethodId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, payableId])
  @@index([tenantId, date])
}

// ---------- Utilizadores e permissões ----------

model User {
  id           String    @id @default(cuid())
  tenantId     String    @default(dbgenerated("current_setting('app.tenant_id')"))
  email        String    @unique
  name         String
  phone        String?
  passwordHash String
  roleId       String
  /// true = acesso a todas as unidades do tenant (dispensa UserUnit)
  allUnits     Boolean   @default(false)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  role           Role            @relation(fields: [tenantId, roleId], references: [tenantId, id])
  userUnits      UserUnit[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  movements      StockMovement[]
  notifications  Notification[]

  @@unique([tenantId, id])
}

model Role {
  id        String   @id @default(cuid())
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  name      String
  /// perfil base criado pela plataforma (não pode ser apagado)
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  users       User[]
  permissions Permission[]

  @@unique([tenantId, name])
  @@unique([tenantId, id])
}

/// Catálogo global de permissões (sem tenantId).
model Permission {
  id    String @id @default(cuid())
  code  String @unique
  roles Role[]
}

model UserUnit {
  tenantId  String   @default(dbgenerated("current_setting('app.tenant_id')"))
  userId    String
  unitId    String
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  unit   Unit   @relation(fields: [tenantId, unitId], references: [tenantId, id])

  @@id([userId, unitId])
  @@index([tenantId])
}

/// Token opaco; só o hash SHA-256 é guardado. Rodado em cada refresh.
model RefreshToken {
  id        String    @id @default(cuid())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id')"))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  tenantId  String    @default(dbgenerated("current_setting('app.tenant_id')"))
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, userId])
}

// ---------- Auditoria ----------

model AuditLog {
  id        String   @id @default(cuid())
  /// null = acção de Super Admin fora de tenant
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
}

// ---------- Analisador IA ----------

enum AiRequestKind {
  CHAT
  ANOMALIES
  FORECAST
  WEEKLY_REPORT
}

/// Cada pedido à API da Anthropic (controlo de custos e limite mensal por tenant).
model AiRequest {
  id            String        @id @default(cuid())
  tenantId      String        @default(dbgenerated("current_setting('app.tenant_id')"))
  /// null = job automático
  userId        String?
  kind          AiRequestKind
  model         String
  promptVersion String
  inputTokens   Int           @default(0)
  outputTokens  Int           @default(0)
  /// custo estimado em micro-USD (1e-6 USD)
  costMicroUsd  Int           @default(0)
  toolCalls     Int           @default(0)
  ok            Boolean       @default(true)
  error         String?
  createdAt     DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

enum AiReportKind {
  ANOMALIES
  WEEKLY
}

/// Relatórios gerados pela IA (anomalias diárias, relatório semanal por unidade).
model AiReport {
  id         String       @id @default(cuid())
  tenantId   String       @default(dbgenerated("current_setting('app.tenant_id')"))
  kind       AiReportKind
  /// null = consolidado
  unitId     String?
  periodFrom DateTime     @db.Date
  periodTo   DateTime     @db.Date
  /// texto (markdown simples) escrito pela IA
  content    String
  /// dados calculados no backend que serviram de base
  data       Json
  createdAt  DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, kind, unitId, periodFrom])
  @@index([tenantId, kind, createdAt])
}
